# Copy to backend/.env for local development.
# Anything marked REQUIRED IN PRODUCTION is enforced by the zod schema in
# src/config/config.ts — the process refuses to start without it.

# Server
PORT=4000
NODE_ENV=development

# Database — REQUIRED in every environment
DATABASE_URL=postgresql://postgres:password@localhost:5432/app

# Auth — REQUIRED IN PRODUCTION (min 32 characters there; a dev default is
# substituted locally). Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# How long an access token lives. The cookie maxAge is derived from this.
ACCESS_TOKEN_MINUTES=15

# Google OAuth — required for sign-in to work at all
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Frontend origin — REQUIRED IN PRODUCTION, CORS depends on it
FRONTEND_URL=http://localhost:3000

# Cookie scope. Leave UNSET locally: localhost:3000 and localhost:4000 are the
# same host, so cookies already work. In production the frontend and API are on
# different subdomains, so this must be the shared parent domain or the browser
# will never send the cookie back — e.g. .example.com
# COOKIE_DOMAIN=.example.com
