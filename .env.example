# Copy to .env.local and replace every value marked CHANGE_ME.

# Supabase-compatible PostgreSQL. For local development, use docker compose.
DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:54322/postgres?schema=public"
DIRECT_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:54322/postgres?schema=public"

# Auth.js / NextAuth. Generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_VALUE"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Northstar"

# A first user can be created through /register. Do not commit credentials.

# Stripe billing (server-side values stay private).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_PRO_PLAN_NAME="Pro"

# Resend transactional email.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Northstar <hello@example.com>"

# Google Drive service account or short-lived access token. Keep private.
GOOGLE_DRIVE_SHARED_DRIVE_ID=""
GOOGLE_DRIVE_ROOT_FOLDER_ID=""
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=""
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_DRIVE_PRIVATE_KEY=""
GOOGLE_DRIVE_ACCESS_TOKEN=""

# Optional Supabase client values for future browser features. Never expose service role keys.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
