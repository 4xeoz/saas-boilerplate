# Copy to .env at the repo root. Used by docker-compose.

DB_PASSWORD=replace-with-a-strong-password

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Supabase / old Cloud Receiver compatibility names. Prefer the session-mode
# pooler URL for the running API and the direct/session URL for migrations.
DATABASE_URL=postgresql://postgres:password@localhost:5432/app
CLOUD_RECEIVER_RUNTIME_DATABASE_URL=
DIRECT_URL=

# Reserved for the later Cloud Receiver connector surface; not used by auth.
CLOUD_RECEIVER_CONNECTOR_TOKEN_SECRET=
CLOUD_RECEIVER_VERIFICATION_ORIGIN=
CLOUD_RECEIVER_GRANT_CONTROL_TOKEN=
# Required in production. Generate with: openssl rand -hex 32
CLOUD_RECEIVER_PAIRING_SOURCE_HMAC_SECRET=

# Base URL used in opaque account consent URLs.
RECEIVER_PUBLIC_URL=http://localhost:4000

FRONTEND_URL=https://example.com
NEXT_PUBLIC_BACKEND_URL=https://api.example.com

# Shared parent domain, so cookies set by the API subdomain reach the frontend.
COOKIE_DOMAIN=.example.com
